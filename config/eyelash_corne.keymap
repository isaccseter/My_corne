#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    Ctrl_Z: Ctrl_Z {
        compatible = "zmk,behavior-hold-tap";
        label = "CTRL_Z";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        hold-while-undecided;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <0 12>;
        };

        alt_tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <13 14>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <0 1>;
        };

        Ctrl_X {
            bindings = <&kp LC(X)>;
            key-positions = <42 43>;
            timeout-ms = <300>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "默认层";
            bindings = <
&kp ESC              &kp Q  &kp W  &kp E      &kp R      &kp T                             &kp UP                &kp Y          &kp U  &kp I      &kp O    &kp P      &kp BSPC
&mt LG(TAB) TAB      &kp A  &kp S  &kp D      &kp F      &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H          &kp J  &kp K      &kp L    &kp ENTER  &kp SQT
&Ctrl_Z LCTRL LC(Z)  &kp Z  &kp X  &kp C      &kp V      &kp B      &kp SPACE              &kp DOWN              &kp N          &kp M  &kp COMMA  &kp DOT  &kp FSLH   &kp ESC
                                   &kp LC(C)  &kp LC(V)  &kp SPACE                                               &kp LC(SPACE)  &mo 0  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        Ctrl_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp A   &kp S   &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "暂定为ctrl快捷键层";
        };
    };
};
