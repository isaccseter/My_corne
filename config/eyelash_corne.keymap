#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    Ctrl_Z: Ctrl_Z {
        compatible = "zmk,behavior-hold-tap";
        label = "CTRL_Z";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        hold-while-undecided;
    };

    dot_exclamation: dot_exclamation {
        compatible = "zmk,behavior-mod-morph";
        label = "DOT_EXCLAMATION";
        bindings = <&kp PERIOD>, <&kp EXCLAMATION>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    comma_question: comma_question {
        compatible = "zmk,behavior-mod-morph";
        label = "COMMA_QUESTION";
        bindings = <&kp COMMA>, <&kp QUESTION>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    minus_caret: minus_caret {
        compatible = "zmk,behavior-mod-morph";
        label = "MINUS_CARET";
        bindings = <&kp MINUS>, <&kp CARET>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    Rlt: Rlt {
        compatible = "zmk,behavior-hold-tap";
        label = "RLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <45 46 47 42 43 44 0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33>;
        hold-trigger-on-release;
    };

    Llt: Llt {
        compatible = "zmk,behavior-hold-tap";
        label = "LLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <45 46 47 42 43 44 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 46 47>;
        hold-trigger-on-release;
    };

    Rmt: Rmt {
        compatible = "zmk,behavior-hold-tap";
        label = "RMT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <45 46 47 42 43 44 0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33>;
        hold-trigger-on-release;
    };

    Lmt: Lmt {
        compatible = "zmk,behavior-hold-tap";
        label = "LMT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <45 46 47 42 43 44 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 46 47>;
        hold-trigger-on-release;
    };

    Rmt_dot: Rmt_dot {
        compatible = "zmk,behavior-hold-tap";
        label = "RMT_DOT";
        bindings = <&kp>, <&dot_exclamation>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        quick-tap-ms = <150>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-key-positions = <45 46 47 42 43 44 0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33>;
        hold-trigger-on-release;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <0 12>;
        };

        semicolon-Return {
            bindings = <&semicolon_Return>;
            key-positions = <25 26>;
        };

        space_EnCn {
            bindings = <&space_EnCn>;
            key-positions = <44 45>;
            timeout-ms = <300>;
        };

        Caps_word {
            bindings = <&caps_word>;
            key-positions = <39 40>;
            timeout-ms = <300>;
        };

        CtrC {
            bindings = <&kp LC(C)>;
            key-positions = <0 1>;
        };

        CtrA_CtrC {
            bindings = <&CtrA_CtrC>;
            key-positions = <0 1 2>;
        };

        CtrV {
            bindings = <&kp LC(V)>;
            key-positions = <13 14>;
        };

        CtrA_Del {
            bindings = <&CtrA_Del>;
            key-positions = <42 43>;
        };

        AltsPace {
            bindings = <&kp LA(SPACE)>;
            key-positions = <38 39>;
        };

        Caps_dot {
            bindings = <&Caps_dot>;
            key-positions = <37 38>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        semicolon_Return: semicolon_Return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&macro_wait_time 30>, <&kp RET>;

            label = "SEMICOLON_RETURN";
        };

        space_EnCn: space_EnCn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&macro_wait_time 30>, <&kp LC(SPACE)>;

            label = "SPACE_ENCN";
        };

        CtrA_CtrC: CtrA_CtrC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>, <&macro_wait_time 30>, <&kp LC(C)>;

            label = "CTRA_CTRC";
        };

        CtrA_Del: CtrA_Del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>, <&macro_wait_time 30>, <&kp DELETE>;

            label = "CTRA_DEL";
        };

        Caps_dot: Caps_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&macro_wait_time 30>, <&kp DOT>;

            label = "CAPS_DOT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "默认层";
            bindings = <
&kp ESC          &kp Q  &kp W            &kp E              &kp R                &kp T                             &kp UP                &kp Y          &kp U           &kp I               &kp O                 &kp P                  &kp BSPC
&mt LA(TAB) TAB  &kp A  &kp S            &Lmt LEFT_SHIFT D  &kp F                &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H          &kp J           &Rmt RIGHT_SHIFT K  &kp L                 &Rmt RIGHT_WIN RETURN  &minus_caret
&kp COLON        &kp Z  &Lmt LEFT_ALT X  &kp C              &Lmt LCTRL V         &kp B      &kp SPACE              &kp DOWN              &kp N          &Rmt RCTRL M    &kp COMMA           &Rmt_dot RIGHT_ALT 0  &kp SINGLE_QUOTE       &kp BACKSLASH
                                         &kp DELETE         &Ctrl_Z LCTRL LC(Z)  &kp SPACE                                               &kp LC(SPACE)  &kp UNDERSCORE  &kp SLASH
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&trans  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE                         &trans          &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &kp QUESTION       &trans
&trans  &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND            &trans  &trans  &trans  &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &trans            &trans          &kp AT_SIGN  &kp COLON             &kp COMMA              &kp DOT        &kp APOSTROPHE     &trans
                                        &trans            &trans             &trans                                           &trans       &trans                &trans
            >;
        };
    };
};
